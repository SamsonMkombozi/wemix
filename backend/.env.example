# Copy to .env and fill in real values. Never commit the real .env file.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=habariplatform.co.tz,www.habariplatform.co.tz
CSRF_TRUSTED_ORIGINS=https://habariplatform.co.tz

# postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://habari:habari@localhost:5432/habari_platform

CORS_ALLOWED_ORIGINS=https://habariplatform.co.tz

# Business rules
PLATFORM_COMMISSION_RATE=0.10

# Selcom payment gateway (sandbox base URL shown; switch for production)
SELCOM_API_BASE_URL=https://apigwtest.selcommobile.com
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR_ID=
SELCOM_WEBHOOK_IP_ALLOWLIST=
SELCOM_WEBHOOK_URL=http://localhost:8000/api/payments/webhooks/selcom/

# Email (verification links, password resets). Console backend prints
# emails to the runserver terminal in dev -- leave EMAIL_BACKEND unset
# locally, it defaults correctly based on DEBUG.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Habari Platform <no-reply@habariplatform.co.tz>

# Used to build links inside emails (e.g. email verification) and as the
# Selcom checkout redirect target. Point this at your frontend's origin.
FRONTEND_BASE_URL=http://localhost:8080

# AI verification engine
AI_VERIFICATION_API_URL=
AI_VERIFICATION_API_KEY=
AI_AUTO_REJECT_THRESHOLD=80.0
AI_AUTO_VERIFY_THRESHOLD=20.0
