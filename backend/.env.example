# Copy to .env and fill in real values. Never commit the real .env file.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=habariplatform.co.tz,www.habariplatform.co.tz
CSRF_TRUSTED_ORIGINS=https://habariplatform.co.tz

# postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://habari:habari@localhost:5432/habari_platform

CORS_ALLOWED_ORIGINS=https://habariplatform.co.tz

# Business rules
PLATFORM_COMMISSION_RATE=0.10

# Selcom payment gateway (sandbox base URL shown; switch for production)
SELCOM_API_BASE_URL=https://apigwtest.selcommobile.com
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR_ID=
SELCOM_WEBHOOK_IP_ALLOWLIST=
SELCOM_WEBHOOK_URL=http://localhost:8000/api/payments/webhooks/selcom/

# Email (verification links, password resets). Console backend prints
# emails to the runserver terminal in dev -- leave EMAIL_BACKEND unset
# locally, it defaults correctly based on DEBUG.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Habari Platform <no-reply@habariplatform.co.tz>

# Used to build links inside emails (e.g. email verification) and as the
# Selcom checkout redirect target. Point this at your frontend's origin.
FRONTEND_BASE_URL=http://localhost:8080

# AI verification engine
AI_VERIFICATION_API_URL=
AI_VERIFICATION_API_KEY=
AI_AUTO_REJECT_THRESHOLD=80.0
AI_AUTO_VERIFY_THRESHOLD=20.0

# Error tracking (optional). Leave blank to disable entirely -- create a
# project at sentry.io (or a self-hosted instance) to get a real DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Payout holding period (hours) before a seller's earning counts as
# withdrawable -- covers the window a buyer can still file a refund.
WALLET_HOLD_PERIOD_HOURS=72

# Free full-story unlocks a buyer gets per calendar month before every
# story requires payment or an active subscription.
FREE_PREVIEW_QUOTA_PER_MONTH=3

# Async task queue (optional). Leave blank to run AI verification/OCR/
# image analysis inline (identical to not having Celery at all). Set to
# a real Redis URL (e.g. redis://localhost:6379/0) AND run
# `celery -A habari_platform worker` to make them genuinely async.
CELERY_BROKER_URL=

# Separate webhook URL for subscription payments (vs. one-off listing
# purchases at SELCOM_WEBHOOK_URL above).
SELCOM_SUBSCRIPTION_WEBHOOK_URL=http://localhost:8000/api/payments/webhooks/selcom-subscription/
